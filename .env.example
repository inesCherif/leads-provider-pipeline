# Copy to .env (gitignored) and fill in. Every variable below is read by the
# code; nothing else is. Each service is a FREE tier, created WITHOUT a credit
# card - create your own account, keys are personal.

# -- Supabase (M1, M4, check_data_quality, exports; read-only in m5_s19 / m6_s19 / m7_s19)
# Use the SESSION-MODE POOLER, not the direct connection.
# The direct host (db.<ref>.supabase.co) resolves to IPv6 only. On a machine
# with no IPv6 route psycopg2 fails with "could not translate host name ...",
# which looks like bad credentials and is not. The pooler has IPv4 records.
# Note the username format: postgres.<project-ref>, not plain "postgres".
# Dashboard -> Project Settings -> Database -> Connection string -> Session pooler.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-<region>.pooler.supabase.com:5432/postgres

# -- Web search (scripts/m2lib_search.py; ddgs needs no key)
# Serper: https://serper.dev - 2,500 one-time credits. Only /maps returns phones (3 credits).
# Tavily: https://tavily.com - 1,000 credits/month.
# Quota is counted locally (checkpoints/search_quota.json) and hard-stops at the free tier.
# After changing a key:  python scripts/m2lib_search.py --reset-pool serper
SERPER_API_KEY=
TAVILY_API_KEY=

# -- France Travail offers (scripts/m5_s16_francetravail.py, proof of activity) - https://francetravail.io
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# -- E-mail verification by API (scripts/m2_s20_verify_api.py, run --pilot first)
# Reoon: https://emailverifier.reoon.com/register/ - 600/month, no card.
# Its pilot FAILED here (too permissive on catch-all role accounts): optional.
REOON_API_KEY=
MILLIONVERIFIER_API_KEY=

# -- SMTP verification identity (scripts/m1_s9g_verify_emails.py) - optional,
# defaults are in the script. A residential IP is refused by Orange / SFR /
# Outlook / Yahoo: those stay "non verifie", they are not invalid.
VERIFY_MAIL_FROM=
VERIFY_HELO=

# -- Google Places (scripts/m3ag_s5_places.py) - NEEDS BILLING, never used in
# production here. Leave empty unless the company decides to pay for it.
GOOGLE_PLACES_API_KEY=

# Supabase MCP (.mcp.json) reads SUPABASE_ACCESS_TOKEN from the SHELL
# environment, NOT from this file - Claude Code does not load .env.
#   [Environment]::SetEnvironmentVariable("SUPABASE_ACCESS_TOKEN","sbp_...","User")
# Token: https://supabase.com/dashboard/account/tokens - see .mcp.json.example
