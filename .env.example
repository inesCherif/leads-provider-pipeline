# Supabase MCP server (.mcp.json) reads SUPABASE_ACCESS_TOKEN from the SHELL
# environment, NOT from this .env file — Claude Code does not load .env.
# Set it as a persistent Windows user env var instead, then restart Claude Code:
#   [Environment]::SetEnvironmentVariable("SUPABASE_ACCESS_TOKEN","sbp_...","User")
# Token: https://supabase.com/dashboard/account/tokens

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Use the SESSION-MODE POOLER, not the direct connection.
# The direct host (db.<ref>.supabase.co) now resolves to IPv6 only. On a machine
# with no IPv6 route psycopg2 fails with "could not translate host name ...
# Name or service not known". The pooler has IPv4 records and works everywhere.
# Note the username format: postgres.<project-ref>, not plain "postgres".
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-<region>.pooler.supabase.com:5432/postgres

# INSEE SIRENE API (free — register at https://api.insee.fr)
INSEE_API_KEY=your-insee-api-key-here

# Email verification (free tiers)
MILLIONVERIFIER_API_KEY=your-key-here
HUNTER_API_KEY=your-key-here

# M2 V3 search APIs (free tiers, NO credit card required)
# Serper: https://serper.dev — 2,500 one-time credits. Its /places endpoint
#   returns Google Maps listings WITH phone numbers (the sector-2 unlock).
# Tavily: https://tavily.com — 1,000 credits/month, web search + snippets.
# Quota is counted locally in exports/boulangerie/checkpoints/search_quota.json
# and hard-stops at the free tier — see scripts/m2lib_search.py.
SERPER_API_KEY=your-serper-key-here
TAVILY_API_KEY=your-tavily-key-here
