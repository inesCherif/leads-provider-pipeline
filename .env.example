# Supabase MCP server (.mcp.json) reads SUPABASE_ACCESS_TOKEN from the SHELL
# environment, NOT from this .env file — Claude Code does not load .env.
# Set it as a persistent Windows user env var instead, then restart Claude Code:
#   [Environment]::SetEnvironmentVariable("SUPABASE_ACCESS_TOKEN","sbp_...","User")
# Token: https://supabase.com/dashboard/account/tokens

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# INSEE SIRENE API (free — register at https://api.insee.fr)
INSEE_API_KEY=your-insee-api-key-here

# Email verification (free tiers)
MILLIONVERIFIER_API_KEY=your-key-here
HUNTER_API_KEY=your-key-here
